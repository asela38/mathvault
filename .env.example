# Copy to .env (or export) — all optional; defaults suit local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Path of the HIBP Bloom filter. Build a demo one with `make demo-bloom`.
PWNED_BLOOM_PATH=data/pwned/current.bloom
# When the Bloom file is missing/corrupt: 0 = fail open (Django's common list still applies), 1 = fail closed.
PWNED_FAIL_CLOSED=0
# Also query the HIBP k-anonymity range API at validation time (needs outbound HTTPS).
PWNED_API_ENABLED=1
